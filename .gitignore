test-login.js
check-login.sh
check-admin*.js
*-login.*
_*.mjs
_*.js
_*.txt
# Local release staging used by deploy/audit-release.ps1
_release/
# Scratch reference files staged in public/ for local visual comparison
app/public/_*.html

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Uploads (local only)
server/uploads/

# Pre-restore database snapshots (contain content, never commit)
server/backups/

# TypeScript cache
*.tsbuildinfo
